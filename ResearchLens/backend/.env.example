# ResearchLens Backend Configuration
APP_NAME=ResearchLens
APP_ENV=development
DATABASE_URL=sqlite:///./researchlens.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hugging Face Summarization Model (loaded lazily; extractive fallback used if unavailable)
HF_SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_HF_MODELS=true
